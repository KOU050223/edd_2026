{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    // 拡張は Node.js 上で動く。console / setTimeout はここから来る。
    // dom は入れない。fetch や localStorage など実行時に存在しない API が
    // 補完に出て、動かないコードが書けてしまうため。
    "types": ["node", "vscode"],
    // 出力は esbuild のバンドル（npm run bundle → dist/）が担う。tsc は型検査専用。
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
