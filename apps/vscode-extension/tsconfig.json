{
  "compilerOptions": {
    // 出力は esbuild がバンドルするので、解決もバンドラーに合わせる。Node16 の CommonJS 扱いだと
    // ESM 専用の依存（effect v4）を型検査で import できない。
    "module": "Preserve",
    "target": "ES2022",
    "lib": ["ES2022"],
    // 拡張は Node.js 上で動く。console / setTimeout はここから来る。
    // dom は入れない。fetch や localStorage など実行時に存在しない API が
    // 補完に出て、動かないコードが書けてしまうため。
    "types": ["node", "vscode"],
    // 出力は esbuild のバンドル（npm run bundle → dist/）が担う。tsc は型検査専用。
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // Effect 固有の診断（yield* の付け忘れ、捨てられた Effect など）をエディタに出す。
    // tsc はプラグインを読まないので、CI では `effect-language-service diagnostics` で回す。
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
