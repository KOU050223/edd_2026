{
  "name": "gakushu-sochi",
  "displayName": "Gakushu Sochi",
  "description": "選択したコードやエラーをその場でAIに質問しながら学べる、学習向けAIコンパニオン",
  "version": "0.0.1",
  "publisher": "gakushu-sochi",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": "24.20.x"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "chatParticipants": [
      {
        "id": "gakushuSochi.chat",
        "name": "gakushu-sochi",
        "fullName": "Gakushu Sochi",
        "description": "選択したコードを学習する"
      }
    ],
    "commands": [
      {
        "command": "gakushuSochi.login",
        "title": "Gakushu Sochi: ログイン"
      },
      {
        "command": "gakushuSochi.logout",
        "title": "Gakushu Sochi: ログアウト"
      },
      {
        "command": "gakushuSochi.askSelection",
        "title": "Gakushu Sochi: Ask Selection"
      },
      {
        "command": "gakushuSochi.askTerminalSelection",
        "title": "Gakushu Sochi: Ask Terminal Selection"
      },
      {
        "command": "gakushuSochi.askClipboard",
        "title": "Gakushu Sochi: Ask Clipboard"
      },
      {
        "command": "gakushuSochi.reviewConsent",
        "title": "Gakushu Sochi: 送信内容の同意を確認する"
      },
      {
        "command": "gakushuSochi.revokeConsent",
        "title": "Gakushu Sochi: 送信内容の同意を取り消す"
      },
      {
        "command": "gakushuSochi.deleteLearningData",
        "title": "Gakushu Sochi: 学習データを削除する"
      },
      {
        "command": "gakushuSochi.openKeybindings",
        "title": "Gakushu Sochi: キーボードショートカットを変更する"
      },
      {
        "command": "gakushuSochi.setByokApiKey",
        "title": "Gakushu Sochi: BYOK の API キーを設定する"
      },
      {
        "command": "gakushuSochi.clearByokApiKey",
        "title": "Gakushu Sochi: BYOK の API キーを削除する"
      }
    ],
    "keybindings": [
      {
        "command": "gakushuSochi.askSelection",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "editorTextFocus"
      },
      {
        "command": "gakushuSochi.askTerminalSelection",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "terminalFocus"
      },
      {
        "command": "gakushuSochi.askClipboard",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ],
    "configuration": {
      "title": "Gakushu Sochi",
      "properties": {
        "gakushuSochi.api.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "https://gakushu-sochi-api.uozumi05.workers.dev",
          "description": "学習イベントを同期するAPIサーバーのURL。空にすると同期を行わずローカル保存のみになる。"
        },
        "gakushuSochi.ai.persona": {
          "type": "string",
          "scope": "application",
          "default": "",
          "maxLength": 500,
          "description": "AI の応答に求める人物像・口調（例: 優しい先生、幼馴染）。空にすると通常の口調で回答する。ワークスペースからは設定できない。"
        },
        "gakushuSochi.ai.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "byok"
          ],
          "scope": "machine",
          "default": "vscode-lm",
          "description": "AI への送信経路。vscode-lm は VS Code に登録済みのモデル（Copilot など）を使う。byok はこの拡張に登録した自分の API キーで直接 AI 提供元を呼ぶ。送信先を左右する設定のためワークスペースからは上書きできない。"
        },
        "gakushuSochi.byok.vendor": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai"
          ],
          "scope": "machine",
          "default": "anthropic",
          "description": "ai.provider が byok のときに使う AI 提供元。"
        },
        "gakushuSochi.byok.model": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "ai.provider が byok のときに使うモデル名。空にすると提供元ごとの既定モデルになる。"
        },
        "gakushuSochi.byok.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "ai.provider が byok のときの送信先 URL。空にすると提供元の公式エンドポイントになる。OpenAI 互換エンドポイントやローカルモデルに向ける場合に使う。https のみ（localhost などのループバックは http も可）。末尾の /v1 は含めても含めなくてもよい。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && npx --no-install @vscode/vsce package --no-dependencies",
    "test:unit": "npm run compile --workspace=@gakushu-sochi/domain && vitest run src",
    "test:watch": "npm run compile --workspace=@gakushu-sochi/domain && vitest src",
    "test": "npm run test:unit",
    "watch": "npm run compile --workspace=@gakushu-sochi/domain && tsc -watch -p ./",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@gakushu-sochi/domain": "file:../../packages/domain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
