{
  "name": "gakushu-sochi",
  "displayName": "Gakushu Sochi",
  "description": "選択したコードやエラーをその場でAIに質問しながら学べる、学習向けAIコンパニオン",
  "version": "0.0.1",
  "publisher": "gakushu-sochi",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": "24.20.x"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "chatParticipants": [
      {
        "id": "gakushuSochi.chat",
        "name": "gakushu-sochi",
        "fullName": "Gakushu Sochi",
        "description": "選択したコードを学習する"
      }
    ],
    "commands": [
      {
        "command": "gakushuSochi.login",
        "title": "Gakushu Sochi: ログイン"
      },
      {
        "command": "gakushuSochi.askSelection",
        "title": "Gakushu Sochi: Ask Selection"
      },
      {
        "command": "gakushuSochi.askTerminalSelection",
        "title": "Gakushu Sochi: Ask Terminal Selection"
      },
      {
        "command": "gakushuSochi.askClipboard",
        "title": "Gakushu Sochi: Ask Clipboard"
      }
    ],
    "keybindings": [
      {
        "command": "gakushuSochi.askSelection",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "editorTextFocus"
      },
      {
        "command": "gakushuSochi.askTerminalSelection",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "terminalFocus"
      },
      {
        "command": "gakushuSochi.askClipboard",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ],
    "configuration": {
      "title": "Gakushu Sochi",
      "properties": {
        "gakushuSochi.api.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "https://gakushu-sochi-api.uozumi05.workers.dev",
          "description": "学習イベントを同期するAPIサーバーのURL。空にすると同期を行わずローカル保存のみになる。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && npx --no-install @vscode/vsce package --no-dependencies",
    "test:unit": "vitest run src",
    "test:watch": "vitest src",
    "test": "npm run test:unit",
    "watch": "npm run compile --workspace=@gakushu-sochi/domain && tsc -watch -p ./",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@gakushu-sochi/domain": "file:../../packages/domain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
