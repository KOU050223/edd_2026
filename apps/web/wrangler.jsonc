{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gakushu-sochi-web",
  "account_id": "996d4f5f54227fcc10dd15a2baee0a5b",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login", "/logout"],
  },
  "vars": { "API_ORIGIN": "https://gakushu-sochi-api.uozumi05.workers.dev" },
  "secrets": { "required": ["API_TOKEN", "WEB_ACCESS_PASSPHRASE"] },
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "c652d3fa57234d318beffb571e594eb3" },
    { "binding": "MASTERY_OVERRIDES", "id": "22f96dcf879c4e0e84bf01e80b692696" },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
