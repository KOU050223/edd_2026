{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Effect 固有の診断（yield* の付け忘れ、捨てられた Effect など）をエディタに出す。
    // tsc はプラグインを読まないので、CI では `effect-language-service diagnostics` で回す。
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src"]
}
