{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gakushu-sochi-api",
  // デプロイ先アカウントを固定する。これが無いと各自の Cloudflare アカウントへ
  // デプロイされ、`<worker名>.<各自のサブドメイン>.workers.dev` と URL が分岐する。
  "account_id": "996d4f5f54227fcc10dd15a2baee0a5b",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    // apps/web からの利用を許可する生成元をカンマ区切りで並べる。
    // 認証付きの API なので "*" にしない。空なら誰も許可しない。
    "CORS_ALLOWED_ORIGINS": "",
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Auth0 の issuer。OIDC Discovery が返す値をそのまま置く（末尾スラッシュ必須）。
    // docs/auth.md §4 はこの値と Discovery 文書の `issuer` の一致を要求するため、
    // 手で書き換えず .well-known/openid-configuration の値を使う。
    "AUTH_ISSUER": "https://gakushu-sochi.jp.auth0.com/",
    // 自 API の audience。これを検証しないと同一テナントの別アプリ向けトークンで
    // この API を呼べる（docs/auth.md §4）。
    "AUTH_AUDIENCE": "https://api.gakushu-sochi.dev",
    // JWKS の URL は意図的に設定項目にしない。AUTH_ISSUER の OIDC Discovery から
    // 導出する（docs/auth.md §4）。設定可能にすると取得先だけを差し替える誤設定が
    // 成立し、任意の鍵で署名したトークンが通る。
  },
  // 必要な秘密情報の「名前」を宣言する。値はここに書かない
  // （`wrangler secret put` で設定する。apps/api/README.md）。
  //
  // これを書くと wrangler types が .dev.vars ではなくこの宣言から型を作るため、
  // .dev.vars を持たない CI でも check:worker-types が通る。
  // デプロイ時には実際に設定済みかどうかも検証される。
  "secrets": {
    // AUTH_MANAGEMENT_* は退会（DELETE /v1/me）で Auth0 のユーザーを消すための
    // M2M クライアント。`delete:users` だけを付けること。全ユーザーを消せる
    // 資格情報なので、余分な scope を持たせない（docs/auth.md §8）。
    "required": ["GEMINI_API_KEY", "AUTH_MANAGEMENT_CLIENT_ID", "AUTH_MANAGEMENT_CLIENT_SECRET"],
  },
  // レート制限。認証済みトークンであっても無制限に叩けないようにする。
  // period は 10 か 60 のみ。
  "ratelimits": [
    {
      // 同期。1回で最大500件を書けるため、頻度そのものを抑える。
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // Profile は毎回そのユーザーの全イベントを読み直して習熟度を導出するので、
      // 同期より負荷が高い。上限を厳しくする。
      "name": "PROFILE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      // 手動上書きはイベント全件の導出をしないため、Profile と別枠にする。
      "name": "MASTERY_OVERRIDE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gakushu-sochi",
      "database_id": "be8561ac-2389-4cfa-b218-f53bce7417a6",
      "migrations_dir": "migrations",
    },
  ],
}
