{
  "name": "@gakushu-sochi/desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "選択したテキストをすぐに質問できる常駐型 AI コンパニオン",
  "author": "Gakushu Sochi contributors",
  "scripts": {
    "compile": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "lint": "eslint src",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "main": "out/main/index.js",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@gakushu-sochi/domain": "file:../../packages/domain",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "valibot": "^1.5.0",
    "vite": "^8.0.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.gakushusochi.desktop",
    "afterPack": "./scripts/after-pack.mjs",
    "electronFuses": {
      "resetAdHocDarwinSignature": true,
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "productName": "Gakushu Sochi",
    "artifactName": "Gakushu-Sochi-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "ja",
      "en"
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "../../assets/icons/app.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "../../assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}
