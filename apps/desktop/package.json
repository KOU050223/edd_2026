{
  "name": "@gakushu-sochi/desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "選択したテキストをすぐに質問できる常駐型 AI コンパニオン",
  "author": "Gakushu Sochi contributors",
  "scripts": {
    "compile": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "lint": "eslint src",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "main": "out/main/index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gakushu-sochi/domain": "file:../../packages/domain",
    "@types/node": "^24.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.gakushusochi.desktop",
    "afterPack": "./scripts/after-pack.mjs",
    "productName": "Gakushu Sochi",
    "artifactName": "Gakushu-Sochi-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "../../assets/icons/app.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "../../assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KOU050223",
        "repo": "edd_2026"
      }
    ]
  }
}
