{
  // main プロセス・preload・shared・ビルド設定の検査。DOM は持ち込まない。
  // renderer が共有する src/shared もここで検査し、Node 側から DOM 型を
  // 参照できないことを境界として維持する。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "vite.*.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "out"]
}
